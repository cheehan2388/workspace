<?xml version="1.0"?>
<sdf version="1.8">
  <!-- 我的機器人：尺寸照 TurtleBot3 Burger。所有場景用 <include> 共用這一份 -->
  <model name="my_robot">

    <!-- 車身：長 0.14、寬 0.12、高 0.06。中心在 z = 0.06，所以車底離地 0.03 -->
    <link name="chassis">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0015</ixx><iyy>0.00193</iyy><izz>0.00283</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.14 0.12 0.06</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.14 0.12 0.06</size></box></geometry>
        <material>
          <ambient>0.9 0.6 0.1 1</ambient>
          <diffuse>0.9 0.6 0.1 1</diffuse>
        </material>
      </visual>

      <!-- 萬向輪：車尾下方一顆小球，摩擦力設成 0，讓它在地上滑而不是卡住 -->
      <collision name="caster_collision">
        <pose>-0.05 0 -0.045 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <pose>-0.05 0 -0.045 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </visual>
    </link>

    <!-- 左輪：圓柱預設是直立的，-1.5708 是繞 x 軸轉 90 度，讓它側躺變成輪子 -->
    <link name="left_wheel">
      <pose>0.02 0.08 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.000054</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 右輪：跟左輪一樣，只是 y 從 0.08 變成 -0.08 -->
    <link name="right_wheel">
      <pose>0.02 -0.08 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.000054</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 關節：把輪子「釘」在車身上，但允許它沿著車軸（y 方向）轉動 -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- 差速驅動：收到「前進速度 + 轉彎速度」的指令，自動換算成左右輪各轉多快 -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.16</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- TF：發布「odom → base_link」，也就是車子相對出發點的位置 -->
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <!-- TurtleBot3 Burger 的速度上限 -->
      <max_linear_velocity>0.22</max_linear_velocity>
      <min_linear_velocity>-0.22</min_linear_velocity>
      <max_angular_velocity>2.84</max_angular_velocity>
      <min_angular_velocity>-2.84</min_angular_velocity>
      <!-- 加速度上限：照抄 Nav2 官方 TurtleBot3 模擬 -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>

    <!-- 光達零件：車頂上一個小圓柱。中心 z = 0.11，車頂在 0.09，所以光達射線不會打到自己的車身 -->
    <link name="lidar_link">
      <pose>-0.02 0 0.11 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- 光達感測器本身 -->
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <!-- 水平方向：轉一圈 360 條射線，每 1 度一條 -->
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
            <!-- 垂直方向只有 1 層，也就是 2D 光達 -->
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <!-- 量測距離：照真實 TurtleBot3 光達 (LDS-01) 規格，0.12 到 3.5 公尺 -->
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <!-- 雜訊：讓讀數有一點隨機誤差，模擬真實光達 -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <!-- 固定關節：把光達「焊死」在車身上，不能轉也不能動 -->
    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
