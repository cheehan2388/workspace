<?xml version="1.0"?>
<sdf version="1.8">
  <!-- BARN 第 192 號地圖（原始檔 world_192.world，341 根圓柱）。起點 (-2.25, 3.0) 朝北，終點 (-2.25, 13.0) -->
  <world name="barn_192">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 起點（藍）與終點（綠）標記：只有外觀，沒有碰撞，光達看不到 -->
    <model name="start_marker">
      <static>true</static>
      <pose>-2.25 3.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_marker">
      <static>true</static>
      <pose>-2.25 13.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.0</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 0.6</ambient><diffuse>0.1 0.7 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- BARN 障礙物：半徑 0.075 m、高 1 m 的圓柱 -->
    <model name="barn_obstacles">
      <static>true</static>
      <link name="link">
        <collision name="c0"><pose>-0.0750 0.0750 0.5 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>1</length></cylinder></geometry></collision>
