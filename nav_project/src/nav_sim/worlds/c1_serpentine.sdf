<?xml version="1.0"?>
<sdf version="1.8">
  <!-- C1 蜿蜒路線（改編自 Hybrid 論文 C1）：三條 1.0 m 寬的走廊，兩個 180 度彎，一扇 0.6 m 的窄門 -->
  <world name="c1_serpentine">

    <!-- 物理設定：每一步模擬 1 毫秒，1 倍速 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo 的基本功能：物理、接收指令、把畫面送給 GUI、讓光達等感測器運作 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 太陽光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地板：20 x 20 公尺的平面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 外框：x 從 -2 到 2，y 從 0 到 3.3。牆厚 0.1，所以每條走廊淨寬剛好 1.0 m
         走廊 A：y 0.05 ~ 1.05（起點）  走廊 B：y 1.15 ~ 2.15  走廊 C：y 2.25 ~ 3.25（終點） -->
    <!-- 外框南牆 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 外框北牆 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 外框西牆 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 1.65 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 外框東牆 -->
    <model name="wall_east">
      <static>true</static>
      <pose>2.0 1.65 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 隔牆 1：分開走廊 A、B，右端留 1.0 m 的缺口（第一個 180 度彎） -->
    <model name="divider_1">
      <static>true</static>
      <pose>-0.525 1.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.95 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.95 0.1 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 隔牆 2：分開走廊 B、C，左端留 1.0 m 的缺口（第二個 180 度彎） -->
    <model name="divider_2">
      <static>true</static>
      <pose>0.525 2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.95 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.95 0.1 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 窄門下半：門在 x = 0.5，兩片牆中間留 0.6 m -->
    <model name="door_south">
      <static>true</static>
      <pose>0.5 2.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.2 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 窄門上半 -->
    <model name="door_north">
      <static>true</static>
      <pose>0.5 3.15 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.2 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 起點（綠） -->
    <model name="start_marker">
      <static>true</static>
      <pose>-1.5 0.55 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 終點（紅） -->
    <model name="goal_marker">
      <static>true</static>
      <pose>1.5 2.75 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 機器人：從 models/my_robot 載入，放在起點 -->
    <include>
      <uri>model://my_robot</uri>
      <name>my_robot</name>
      <pose>-1.5 0.55 0 0 0 0</pose>
    </include>
  </world>
</sdf>
